# Environment Configuration Template
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control
#
# Every variable name below is the name the code actually reads via
# os.getenv(). Renaming any of them will silently break the app.

# =============================================================================
# PALO ALTO NETWORKS AI RUNTIME SECURITY CONFIGURATION
# =============================================================================

# API Key from Strata Cloud Manager
# Get this from: https://apps.paloaltonetworks.com/
PANW_AI_SEC_API_KEY=your_palo_alto_api_key_here

# Security Profile Name (configured in Strata Cloud Manager)
PANW_AI_SEC_PROFILE_NAME=your_security_profile_name

# API Endpoint (choose based on the region your API key was issued in)
# US:        https://service.api.aisecurity.paloaltonetworks.com (default)
# EU:        https://service-de.api.aisecurity.paloaltonetworks.com
# India:     https://service-in.api.aisecurity.paloaltonetworks.com
# Singapore: https://service-sg.api.aisecurity.paloaltonetworks.com
# PANW_AI_SEC_ENDPOINT=https://service.api.aisecurity.paloaltonetworks.com

# Scan metadata (optional). Shown in Strata Cloud Manager sessions and
# violations, so pick values you will recognize. app_user defaults to your
# OS username, ai_model to AZURE_DEPLOY.
# PANW_AI_SEC_APP_NAME=secure-chatbot-azure
# PANW_AI_SEC_APP_USER=jane.doe

# =============================================================================
# AZURE OPENAI CONFIGURATION
# =============================================================================

# Azure OpenAI resource NAME, not the full URL.
# The app builds the endpoint itself as https://<AZURE_PROJECT>.openai.azure.com/
# so put only the resource name here (for example: my-openai-resource).
AZURE_PROJECT=your_azure_openai_resource_name

# Azure OpenAI access key
# Get this from Azure Portal > Your OpenAI Resource > Keys and Endpoint
AZURE_KEY=your_azure_openai_api_key_here

# Azure OpenAI deployment name
# This is the name you gave to your model deployment in Azure OpenAI Studio
AZURE_DEPLOY=your_deployment_name

# Azure OpenAI data-plane API version (optional). The code defaults to the
# GA version 2024-10-21.
# AZURE_API_VERSION=2024-10-21

# =============================================================================
# OPTIONAL CONFIGURATION
# =============================================================================
# The variables below are placeholders for your own extensions. The shipped
# code does not read them (no conversation history is kept, scan timeouts are
# fixed at 30 seconds).

# Application Environment
ENVIRONMENT=development

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# =============================================================================
# SECURITY NOTES
# =============================================================================
#
# 1. Never commit this file with real credentials to version control
# 2. Add .env to your .gitignore file
# 3. Use different .env files for different environments (dev, staging, prod)
# 4. Consider using Azure Key Vault or AWS Secrets Manager for production
# 5. Rotate your API keys regularly
# 6. Use minimum required permissions for your API keys
#
# =============================================================================
